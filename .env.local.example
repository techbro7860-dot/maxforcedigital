# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRUST_CLOUDFLARE_PROXY=false
TRUST_X_REAL_IP=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
JWT_ACCESS_SECRET=replace-with-a-different-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value

# Database
ADMIN_EMAIL=admin@maxforcedigital.com
ADMIN_PASSWORD=replace-with-a-unique-12-to-72-character-password
MONGODB_URI=mongodb://127.0.0.1:27017/maxforce-digital

# Product media and protected digital assets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (test keys locally, live keys only in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Email delivery
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=Maxforce Digital <noreply@maxforcedigital.com>

# Optional Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional production SMS provider for checkout OTP
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
